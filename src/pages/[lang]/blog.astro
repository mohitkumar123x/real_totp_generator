---
import { languages, defaultLang } from "../../i18n/ui";
import type { Lang } from "../../i18n/ui";
import { useTranslations, getAltLangs } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as Lang) || defaultLang;
const t = useTranslations(currentLang);
---

<Layout
  lang={currentLang}
  title={t("blog.title")}
  description={t("blog.desc")}
  breadcrumbs={[
    { name: t("blog.nav.home") || "Home", item: `https://realtotpgenerator.com/${currentLang}/` },
    { name: t("blog.nav.blog") || "Blog", item: `https://realtotpgenerator.com/${currentLang}/blog/` }
  ]}
  isWebApplication={false}
>
  <Navbar lang={currentLang} t={t} />

  <!-- Blog JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": `${t("blog.h1")} — TOTP Generator`,
    "description": t("blog.desc"),
    "url": `https://realtotpgenerator.com/${currentLang}/blog/`,
    "publisher": { "@type": "Organization", "name": "TOTP Generator", "url": "https://realtotpgenerator.com" }
  })} />

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[var(--border)] pt-24 pb-16">
    <div class="mesh-gradient mesh-animate absolute inset-0 opacity-40"></div>
    <div class="relative mx-auto max-w-[1200px] px-6">
      <nav class="mb-6 text-xs text-[var(--text-muted)]" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1.5">
          <li><a href={`/${currentLang}/`} class="no-underline transition-colors hover:text-[var(--text-secondary)]">{t("blog.nav.home")}</a></li>
          <li><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
          <li class="text-[var(--text-secondary)]">{t("blog.nav.blog")}</li>
        </ol>
      </nav>
      <div class="mx-auto max-w-[720px]">
        <p class="hero-animate mb-4 font-[var(--font-mono)] text-xs font-medium uppercase tracking-widest text-[var(--text-muted)]" style="--delay: 0ms">
          {t("nav.blog")}
        </p>
        <h1 class="hero-animate font-display mb-4 text-3xl tracking-tight text-[var(--text-primary)] sm:text-4xl" style="--delay: 100ms">
          {t("blog.h1")}
        </h1>
        <p class="hero-animate text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg" style="--delay: 200ms">
          {t("blog.desc")}
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Article -->
  <section class="py-16" id="featured">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="mx-auto max-w-[960px]">
        <p class="mb-2 font-[var(--font-mono)] text-xs font-medium uppercase tracking-widest text-[var(--accent)]">{t("blog.featured")}</p>

        <article class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-elevated)] p-8 shadow-[var(--shadow-card)]" data-animate="fade-up">
          <div class="mb-4 flex flex-wrap items-center gap-3">
            <span class="rounded-[var(--radius-pill-category)] bg-[var(--accent-soft)] px-3 py-1 text-xs font-medium text-[var(--accent-deep)]">{t("blog.1.category")}</span>
            <span class="text-xs text-[var(--text-faint)]">{t("blog.1.date")}</span>
            <span class="text-xs text-[var(--text-faint)]">{t("blog.1.readtime")} {t("blog.minread")}</span>
          </div>

          <h2 class="font-display mb-4 text-2xl tracking-tight text-[var(--text-primary)] sm:text-3xl">
            {t("blog.1.title")}
          </h2>

          <p class="mb-6 text-base leading-relaxed text-[var(--text-secondary)]">
            {t("blog.1.desc")}
          </p>

          <p class="mb-6 text-sm leading-relaxed text-[var(--text-secondary)]">
            {t("blog.featured.p1")}
          </p>
          <p class="mb-6 text-sm leading-relaxed text-[var(--text-secondary)]">
            {t("blog.featured.p2")}
          </p>

          <!-- Interactive Generator Callout -->
          <div class="my-6 rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg)] p-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-[var(--accent)]">Interactive Tool</span>
                <h3 class="text-sm font-semibold text-[var(--text-primary)] mt-0.5">Need to verify a 2FA code or test a secret key?</h3>
                <p class="text-xs text-[var(--text-secondary)] mt-1">Generate immediate RFC 6238 codes with auto-copy and camera QR scanning.</p>
              </div>
              <a href={`/${currentLang}/#generator`} class="btn-lift inline-flex items-center justify-center whitespace-nowrap rounded-[var(--radius-pill)] bg-[var(--color-ink)] px-4 py-2 text-xs font-medium text-white no-underline transition-opacity hover:opacity-90 dark:bg-white dark:text-black">
                Launch TOTP Generator &rarr;
              </a>
            </div>
          </div>

          <div class="overflow-x-auto rounded-[var(--radius-md)] border border-[var(--border)]">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-[var(--border)] bg-[var(--bg)]">
                  <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.table.thead.method")}</th>
                  <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.table.thead.security")}</th>
                  <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.table.thead.network")}</th>
                  <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.table.thead.phishing")}</th>
                  <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.table.thead.sim")}</th>
                  <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.table.thead.offline")}</th>
                  <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.table.thead.recommended")}</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b border-[var(--border-soft)] bg-[var(--bg-elevated)]">
                  <td class="px-4 py-3 font-medium text-[var(--text-primary)]">{t("blog.table.totp")}</td>
                  <td class="px-4 py-3"><span class="inline-flex items-center rounded-[var(--radius-sm)] bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">{t("blog.table.high")}</span></td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.no")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.partial")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.yes")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.yes")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.yes")}</td>
                </tr>
                <tr class="border-b border-[var(--border-soft)]">
                  <td class="px-4 py-3 font-medium text-[var(--text-primary)]">{t("blog.table.sms")}</td>
                  <td class="px-4 py-3"><span class="inline-flex items-center rounded-[var(--radius-sm)] bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">{t("blog.table.medium")}</span></td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.yes")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.no")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.no")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.no")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.no")}</td>
                </tr>
                <tr class="border-b border-[var(--border-soft)] bg-[var(--bg-elevated)]">
                  <td class="px-4 py-3 font-medium text-[var(--text-primary)]">{t("blog.table.email")}</td>
                  <td class="px-4 py-3"><span class="inline-flex items-center rounded-[var(--radius-sm)] bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">{t("blog.table.medium")}</span></td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.yes")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.no")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.yes")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.no")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.no")}</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-medium text-[var(--text-primary)]">{t("blog.table.hotp")}</td>
                  <td class="px-4 py-3"><span class="inline-flex items-center rounded-[var(--radius-sm)] bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">{t("blog.table.high")}</span></td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.no")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.partial")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.yes")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.yes")}</td>
                  <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.table.no")}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- How TOTP Works - Diagram -->
  <section class="border-y border-[var(--border)] bg-[var(--bg)] py-16" id="how-it-works">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="mx-auto max-w-[960px]">
        <h2 class="font-display mb-2 text-2xl tracking-tight text-[var(--text-primary)]">{t("blog.diagram.how.title")}</h2>
        <p class="mb-10 text-sm text-[var(--text-muted)]">{t("blog.diagram.subtitle")}</p>

        <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-elevated)] p-6 sm:p-8 shadow-[var(--shadow-card)]" data-animate="fade-up">
          <!-- Flow Pipeline Grid -->
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-5 md:gap-3 lg:gap-4 items-stretch">

            <!-- Step 1: Secret Key -->
            <div class="relative flex flex-col justify-between rounded-xl border-2 border-sky-400 bg-white p-4 transition-all hover:shadow-lg hover:border-sky-500 dark:border-sky-500/60 dark:bg-sky-950/60">
              <div>
                <div class="mb-2.5 flex items-center justify-between">
                  <span class="rounded-full bg-sky-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-sky-700 dark:bg-sky-900/80 dark:text-sky-300">{t("blog.diagram.step")} 1</span>
                  <span class="rounded bg-sky-100 px-1.5 py-0.5 font-mono text-[10px] font-bold text-sky-700 dark:bg-sky-900/80 dark:text-sky-300">Base32</span>
                </div>
                <h3 class="text-sm font-extrabold text-slate-900 dark:text-white">{t("blog.diagram.secret")}</h3>
                <p class="mt-1 text-xs font-medium text-slate-600 dark:text-slate-300">{t("blog.diagram.step1")}</p>
              </div>
              <div class="mt-3 flex items-center gap-1.5 rounded-lg border border-sky-200 bg-sky-50 px-2.5 py-1.5 font-mono text-xs font-bold text-sky-800 dark:border-sky-800 dark:bg-sky-950 dark:text-sky-200">
                <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span class="truncate">JBSWY3DPEH...</span>
              </div>
            </div>

            <!-- Step 2: Current Unix Time -->
            <div class="relative flex flex-col justify-between rounded-xl border-2 border-sky-400 bg-white p-4 transition-all hover:shadow-lg hover:border-sky-500 dark:border-sky-500/60 dark:bg-sky-950/60">
              <div>
                <div class="mb-2.5 flex items-center justify-between">
                  <span class="rounded-full bg-sky-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-sky-700 dark:bg-sky-900/80 dark:text-sky-300">{t("blog.diagram.step")} 2</span>
                  <span class="rounded bg-sky-100 px-1.5 py-0.5 font-mono text-[10px] font-bold text-sky-700 dark:bg-sky-900/80 dark:text-sky-300">Unix</span>
                </div>
                <h3 class="text-sm font-extrabold text-slate-900 dark:text-white">{t("blog.diagram.unix")}</h3>
                <p class="mt-1 text-xs font-medium text-slate-600 dark:text-slate-300">{t("blog.diagram.seconds")} 1970-01-01</p>
              </div>
              <div class="mt-3 flex items-center gap-1.5 rounded-lg border border-sky-200 bg-sky-50 px-2.5 py-1.5 font-mono text-xs font-bold text-sky-800 dark:border-sky-800 dark:bg-sky-950 dark:text-sky-200">
                <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/></svg>
                <span class="truncate">1741531200</span>
              </div>
            </div>

            <!-- Step 3: Time Counter -->
            <div class="relative flex flex-col justify-between rounded-xl border-2 border-violet-400 bg-white p-4 transition-all hover:shadow-lg hover:border-violet-500 dark:border-violet-500/60 dark:bg-violet-950/60">
              <div>
                <div class="mb-2.5 flex items-center justify-between">
                  <span class="rounded-full bg-violet-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-violet-700 dark:bg-violet-900/80 dark:text-violet-300">{t("blog.diagram.step")} 3</span>
                  <span class="rounded bg-violet-100 px-1.5 py-0.5 font-mono text-[10px] font-bold text-violet-700 dark:bg-violet-900/80 dark:text-violet-300">T = t / 30</span>
                </div>
                <h3 class="text-sm font-extrabold text-slate-900 dark:text-white">{t("blog.diagram.counter")}</h3>
                <p class="mt-1 text-xs font-medium text-slate-600 dark:text-slate-300">{t("blog.diagram.timestep")}</p>
              </div>
              <div class="mt-3 flex items-center gap-1.5 rounded-lg border border-violet-200 bg-violet-50 px-2.5 py-1.5 font-mono text-xs font-bold text-violet-800 dark:border-violet-800 dark:bg-violet-950 dark:text-violet-200">
                <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10M20 7v10M9 12h6"/></svg>
                <span class="truncate">58051040</span>
              </div>
            </div>

            <!-- Step 4: HMAC Hashing -->
            <div class="relative flex flex-col justify-between rounded-xl border-2 border-violet-400 bg-white p-4 transition-all hover:shadow-lg hover:border-violet-500 dark:border-violet-500/60 dark:bg-violet-950/60">
              <div>
                <div class="mb-2.5 flex items-center justify-between">
                  <span class="rounded-full bg-violet-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-violet-700 dark:bg-violet-900/80 dark:text-violet-300">{t("blog.diagram.step")} 4</span>
                  <span class="rounded bg-violet-100 px-1.5 py-0.5 font-mono text-[10px] font-bold text-violet-700 dark:bg-violet-900/80 dark:text-violet-300">HMAC-SHA</span>
                </div>
                <h3 class="text-sm font-extrabold text-slate-900 dark:text-white">HMAC-SHA Hash</h3>
                <p class="mt-1 text-xs font-medium text-slate-600 dark:text-slate-300">{t("blog.diagram.hash")}</p>
              </div>
              <div class="mt-3 flex items-center gap-1.5 rounded-lg border border-violet-200 bg-violet-50 px-2.5 py-1.5 font-mono text-xs font-bold text-violet-800 dark:border-violet-800 dark:bg-violet-950 dark:text-violet-200">
                <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <span class="truncate">160-bit digest</span>
              </div>
            </div>

            <!-- Step 5: Output OTP Code -->
            <div class="relative flex flex-col justify-between rounded-xl border-2 border-emerald-500 bg-white p-4 transition-all shadow-md hover:shadow-xl dark:border-emerald-400 dark:bg-emerald-950/70">
              <div>
                <div class="mb-2.5 flex items-center justify-between">
                  <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-emerald-800 dark:bg-emerald-900/80 dark:text-emerald-200">{t("blog.diagram.step")} 5</span>
                  <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800 dark:bg-emerald-900/80 dark:text-emerald-200">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
                    {t("blog.diagram.expires")}
                  </span>
                </div>
                <p class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">{t("blog.diagram.truncation")}</p>
                <div class="my-2.5 text-center">
                  <span class="font-mono text-3xl font-black tracking-widest text-emerald-700 dark:text-emerald-300">482901</span>
                </div>
              </div>
              <p class="text-center text-xs font-bold text-emerald-800 dark:text-emerald-300">{t("blog.diagram.output")}</p>
            </div>

          </div>

          <!-- RFC Formula & Details Footer -->
          <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 px-5 py-3.5 dark:border-slate-700 dark:bg-slate-900">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded bg-slate-200 px-2 py-1 font-mono text-[11px] font-black uppercase tracking-wider text-slate-700 dark:bg-slate-700 dark:text-slate-200">RFC 6238</span>
              <code class="font-mono text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100">
                TOTP = HOTP(SecretKey, ⌊(CurrentTime − T0) / TimeStep⌋)
              </code>
            </div>
            <div class="flex shrink-0 items-center gap-3 text-[11px] font-semibold text-slate-600 dark:text-slate-400">
              <span>T0 = 0 (Unix Epoch)</span>
              <span>&bull;</span>
              <span>TimeStep = 30s</span>
            </div>
          </div>
        </div>

        <p class="mt-6 text-sm leading-relaxed text-[var(--text-secondary)]">
          {t("blog.diagram.desc")}
        </p>
      </div>
    </div>
  </section>

  <!-- Algorithm Comparison -->
  <section class="py-16" id="algorithms">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="mx-auto max-w-[960px]">
        <h2 class="font-display mb-2 text-2xl tracking-tight text-[var(--text-primary)]">{t("blog.algo.title")}</h2>
        <p class="mb-10 text-sm text-[var(--text-muted)]">{t("blog.algo.desc")}</p>

        <div class="overflow-x-auto rounded-[var(--radius-md)] border border-[var(--border)] shadow-[var(--shadow-card)]" data-animate="fade-up">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-[var(--border)] bg-[var(--bg)]">
                <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.algo.thead.algo")}</th>
                <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.algo.thead.hash")}</th>
                <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.algo.thead.bits")}</th>
                <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.algo.thead.security")}</th>
                <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.algo.thead.speed")}</th>
                <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.algo.thead.usecase")}</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-[var(--border-soft)] bg-[var(--bg-elevated)]">
                <td class="px-4 py-3 font-medium text-[var(--text-primary)]">{t("blog.algo.sha1")}</td>
                <td class="px-4 py-3 font-mono text-xs text-[var(--text-secondary)]">{t("blog.algo.sha1.desc")}</td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.algo.160")}</td>
                <td class="px-4 py-3"><span class="inline-flex items-center rounded-[var(--radius-sm)] bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">{t("blog.algo.standard")}</span></td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.algo.fastest")}</td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.algo.consumer")}</td>
              </tr>
              <tr class="border-b border-[var(--border-soft)]">
                <td class="px-4 py-3 font-medium text-[var(--text-primary)]">{t("blog.algo.sha256")}</td>
                <td class="px-4 py-3 font-mono text-xs text-[var(--text-secondary)]">{t("blog.algo.sha256.desc")}</td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.algo.256")}</td>
                <td class="px-4 py-3"><span class="inline-flex items-center rounded-[var(--radius-sm)] bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700 dark:bg-blue-900/30 dark:text-blue-400">{t("blog.algo.enhanced")}</span></td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.algo.fast")}</td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.algo.business")}</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-[var(--text-primary)]">{t("blog.algo.sha512")}</td>
                <td class="px-4 py-3 font-mono text-xs text-[var(--text-secondary)]">{t("blog.algo.sha512.desc")}</td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.algo.512")}</td>
                <td class="px-4 py-3"><span class="inline-flex items-center rounded-[var(--radius-sm)] bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">{t("blog.algo.maximum")}</span></td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.algo.moderate")}</td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.algo.highsecurity")}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Step-by-Step Guide -->
  <section class="border-y border-[var(--border)] bg-[var(--bg)] py-16" id="guide">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="mx-auto max-w-[960px]">
        <h2 class="font-display mb-2 text-2xl tracking-tight text-[var(--text-primary)]">{t("blog.guide.title")}</h2>
        <p class="mb-10 text-sm text-[var(--text-muted)]">{t("blog.guide.desc")}</p>

        <div class="overflow-x-auto rounded-[var(--radius-md)] border border-[var(--border)] shadow-[var(--shadow-card)]" data-animate="fade-up">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-[var(--border)] bg-[var(--bg-elevated)]">
                <th class="w-16 px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.guide.thead.step")}</th>
                <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.guide.thead.action")}</th>
                <th class="px-4 py-3 font-subheading text-xs uppercase tracking-wider text-[var(--text-muted)]">{t("blog.guide.thead.detail")}</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-[var(--border-soft)] bg-[var(--bg-elevated)]">
                <td class="px-4 py-3 text-center"><span class="inline-flex h-7 w-7 items-center justify-center rounded-[var(--radius-full)] bg-[var(--accent-soft)] text-xs font-bold text-[var(--accent-deep)]">{t("blog.guide.step1")}</span></td>
                <td class="px-4 py-3 font-medium text-[var(--text-primary)]">{t("blog.guide.action1")}</td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.guide.detail1")}</td>
              </tr>
              <tr class="border-b border-[var(--border-soft)]">
                <td class="px-4 py-3 text-center"><span class="inline-flex h-7 w-7 items-center justify-center rounded-[var(--radius-full)] bg-[var(--accent-soft)] text-xs font-bold text-[var(--accent-deep)]">{t("blog.guide.step2")}</span></td>
                <td class="px-4 py-3 font-medium text-[var(--text-primary)]">
                  {t("blog.guide.action2")}
                  <a href={`/${currentLang}/#generator`} class="font-medium text-[var(--accent)] hover:underline ml-1 inline-flex items-center gap-0.5">[Launch Generator &uarr;]</a>
                </td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.guide.detail2")}</td>
              </tr>
              <tr class="border-b border-[var(--border-soft)] bg-[var(--bg-elevated)]">
                <td class="px-4 py-3 text-center"><span class="inline-flex h-7 w-7 items-center justify-center rounded-[var(--radius-full)] bg-[var(--accent-soft)] text-xs font-bold text-[var(--accent-deep)]">{t("blog.guide.step3")}</span></td>
                <td class="px-4 py-3 font-medium text-[var(--text-primary)]">{t("blog.guide.action3")}</td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.guide.detail3")}</td>
              </tr>
              <tr class="border-b border-[var(--border-soft)]">
                <td class="px-4 py-3 text-center"><span class="inline-flex h-7 w-7 items-center justify-center rounded-[var(--radius-full)] bg-[var(--accent-soft)] text-xs font-bold text-[var(--accent-deep)]">{t("blog.guide.step4")}</span></td>
                <td class="px-4 py-3 font-medium text-[var(--text-primary)]">
                  {t("blog.guide.action4")}
                  <a href={`/${currentLang}/#vault`} class="font-medium text-[var(--accent)] hover:underline ml-1 inline-flex items-center gap-0.5">[Save in Vault &uarr;]</a>
                </td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.guide.detail4")}</td>
              </tr>
              <tr>
                <td class="px-4 py-3 text-center"><span class="inline-flex h-7 w-7 items-center justify-center rounded-[var(--radius-full)] bg-[var(--accent-soft)] text-xs font-bold text-[var(--accent-deep)]">{t("blog.guide.step5")}</span></td>
                <td class="px-4 py-3 font-medium text-[var(--text-primary)]">{t("blog.guide.action5")}</td>
                <td class="px-4 py-3 text-[var(--text-secondary)]">{t("blog.guide.detail5")}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 border-t border-[var(--border)]">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="mx-auto max-w-[720px] text-center" data-animate="fade-up">
        <h2 class="font-display mb-3 text-2xl tracking-tight text-[var(--text-primary)]">{t("blog.newsletter.title")}</h2>
        <p class="mb-6 text-sm text-[var(--text-secondary)]">{t("blog.newsletter.desc")}</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href={`/${currentLang}/`} class="btn-lift inline-flex h-11 items-center rounded-[var(--radius-pill)] bg-[var(--color-ink)] px-6 text-sm font-medium text-white no-underline transition-opacity hover:opacity-90 dark:bg-white dark:text-black">
            {t("hero.cta")}
            <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
          <a href={`/${currentLang}/#vault`} class="btn-lift inline-flex h-11 items-center rounded-[var(--radius-pill)] border border-[var(--border)] bg-[var(--bg-elevated)] px-6 text-sm font-medium text-[var(--text-primary)] no-underline transition-colors hover:bg-[var(--border-soft)]">
            Open Encrypted Vault
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer lang={currentLang} t={t} />
</Layout>
