---
import { languages, defaultLang } from "../../i18n/ui";
import type { Lang } from "../../i18n/ui";
import { useTranslations, getAltLangs } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as Lang) || defaultLang;
const t = useTranslations(currentLang);
---

<Layout lang={currentLang} title={t("contact.title")} description={t("contact.p1")}>
  <Navbar lang={currentLang} t={t} />

  <section class="relative overflow-hidden border-b border-[var(--border)] pt-24 pb-16">
    <div class="mesh-gradient mesh-animate absolute inset-0 opacity-40"></div>
    <div class="relative mx-auto max-w-[1200px] px-6">
      <div class="mx-auto max-w-[720px]">
        <p class="hero-animate mb-4 font-[var(--font-mono)] text-xs font-medium uppercase tracking-widest text-[var(--text-muted)]" style="--delay: 0ms">
          {t("footer.contact")}
        </p>
        <h1 class="hero-animate font-display mb-4 text-3xl tracking-tight text-[var(--text-primary)] sm:text-4xl" style="--delay: 100ms">
          {t("contact.h1")}
        </h1>
        <p class="hero-animate text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg" style="--delay: 200ms">
          {t("contact.p1")}
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="mx-auto max-w-[760px]">
        <div class="grid gap-6 sm:grid-cols-2">
          <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-elevated)] p-6 shadow-[var(--shadow-card)] transition-all duration-200 hover:shadow-[var(--shadow-card-hover)]" data-animate="fade-up">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-[var(--radius-md)] bg-[var(--accent-soft)]">
              <svg class="h-5 w-5 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h2 class="font-heading mb-2 text-lg tracking-tight text-[var(--text-primary)]">
              {t("contact.h2_1")}
            </h2>
            <p class="mb-3 text-sm leading-relaxed text-[var(--text-secondary)]">
              {t("contact.p2")}
            </p>
            <a href="mailto:contact@realtotpgenerator.com" class="inline-flex items-center gap-1 text-sm font-medium text-[var(--accent)] no-underline transition-colors hover:underline">
              contact@realtotpgenerator.com
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

          <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-elevated)] p-6 shadow-[var(--shadow-card)] transition-all duration-200 hover:shadow-[var(--shadow-card-hover)]" data-animate="fade-up" style="--delay: 80ms">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-[var(--radius-md)] bg-[var(--accent-soft)]">
              <svg class="h-5 w-5 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h2 class="font-heading mb-2 text-lg tracking-tight text-[var(--text-primary)]">
              {t("contact.h2_2")}
            </h2>
            <p class="mb-3 text-sm leading-relaxed text-[var(--text-secondary)]">
              {t("contact.p3")}
            </p>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-medium text-[var(--accent)] no-underline transition-colors hover:underline">
              GitHub
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

          <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-elevated)] p-6 shadow-[var(--shadow-card)] transition-all duration-200 hover:shadow-[var(--shadow-card-hover)] sm:col-span-2" data-animate="fade-up" style="--delay: 160ms">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-[var(--radius-md)] bg-[var(--accent-soft)]">
              <svg class="h-5 w-5 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h2 class="font-heading mb-2 text-lg tracking-tight text-[var(--text-primary)]">
              {t("contact.h2_3")}
            </h2>
            <p class="mb-3 text-sm leading-relaxed text-[var(--text-secondary)]">
              {t("contact.p4")}
            </p>
            <a href="mailto:privacy@realtotpgenerator.com" class="inline-flex items-center gap-1 text-sm font-medium text-[var(--accent)] no-underline transition-colors hover:underline">
              privacy@realtotpgenerator.com
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer lang={currentLang} t={t} />
</Layout>
