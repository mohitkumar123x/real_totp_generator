---
import { languages, defaultLang } from "../../i18n/ui";
import type { Lang } from "../../i18n/ui";
import { useTranslations, getAltLangs } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as Lang) || defaultLang;
const t = useTranslations(currentLang);
---

<Layout lang={currentLang} title={t("contact.title")} description={t("contact.p1")}>
  <Navbar lang={currentLang} t={t} />

  <section class="pt-24 pb-16">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="mx-auto max-w-[760px]">
        <h1 class="font-display mb-6 text-3xl tracking-tight text-[var(--text-primary)] sm:text-4xl">
          {t("contact.h1")}
        </h1>
        <p class="mb-8 text-base leading-relaxed text-[var(--text-secondary)]">{t("contact.p1")}</p>

        <div class="flex flex-col gap-8">
          <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-elevated)] p-6 shadow-[var(--shadow-card)]">
            <h2 class="font-heading mb-3 text-lg tracking-tight text-[var(--text-primary)]">
              {t("contact.h2_1")}
            </h2>
            <p class="text-base leading-relaxed text-[var(--text-secondary)]">
              {t("contact.p2")}
            </p>
            <a href="mailto:contact@realtotpgenerator.com" class="mt-3 inline-block text-sm font-medium text-[var(--accent)] no-underline hover:underline">
              contact@realtotpgenerator.com
            </a>
          </div>

          <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-elevated)] p-6 shadow-[var(--shadow-card)]">
            <h2 class="font-heading mb-3 text-lg tracking-tight text-[var(--text-primary)]">
              {t("contact.h2_2")}
            </h2>
            <p class="text-base leading-relaxed text-[var(--text-secondary)]">
              {t("contact.p3")}
            </p>
          </div>

          <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-elevated)] p-6 shadow-[var(--shadow-card)]">
            <h2 class="font-heading mb-3 text-lg tracking-tight text-[var(--text-primary)]">
              {t("contact.h2_3")}
            </h2>
            <p class="text-base leading-relaxed text-[var(--text-secondary)]">
              {t("contact.p4")}
            </p>
            <a href="mailto:privacy@realtotpgenerator.com" class="mt-3 inline-block text-sm font-medium text-[var(--accent)] no-underline hover:underline">
              privacy@realtotpgenerator.com
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer lang={currentLang} t={t} />
</Layout>
