---
import { languages, defaultLang } from "../../i18n/ui";
import type { Lang } from "../../i18n/ui";
import { useTranslations, getAltLangs } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import TotpGenerator from "../../components/TotpGenerator.astro";
import Vault from "../../components/Vault.astro";
import SEOContent from "../../components/SEOContent.astro";
import FAQ from "../../components/FAQ.astro";
import Footer from "../../components/Footer.astro";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as Lang) || defaultLang;
const t = useTranslations(currentLang);
const altLangs = getAltLangs(currentLang);
---

<Layout lang={currentLang} title={t("seo.title")} description={t("seo.desc")}>
  <Navbar lang={currentLang} t={t} />

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[var(--border)] pt-24 pb-16">
    <div class="mesh-gradient mesh-animate absolute inset-0 opacity-60"></div>
    <div class="relative mx-auto max-w-[1200px] px-6">
      <div class="mx-auto max-w-[720px] text-center">
        <p class="hero-animate mb-4 font-[var(--font-mono)] text-xs font-medium uppercase tracking-widest text-[var(--text-muted)]" style="--delay: 0ms">
          {t("hero.badge")}
        </p>
        <h1 class="hero-animate font-display mb-6 text-4xl leading-tight tracking-tight text-[var(--text-primary)] sm:text-5xl md:text-6xl" style="--delay: 100ms">
          {t("hero.title")}
        </h1>
        <p class="hero-animate mb-8 text-lg leading-relaxed text-[var(--text-secondary)] sm:text-xl" style="--delay: 200ms">
          {t("hero.desc")}
        </p>
        <div class="hero-animate flex flex-col items-center justify-center gap-3 sm:flex-row" style="--delay: 300ms">
          <a href="#generator" class="btn-lift inline-flex h-11 items-center rounded-[var(--radius-pill)] bg-[var(--color-ink)] px-6 text-sm font-medium text-white no-underline transition-opacity hover:opacity-90 dark:bg-white dark:text-black">
            {t("hero.cta")}
            <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
          <a href="#vault" class="btn-lift inline-flex h-11 items-center rounded-[var(--radius-pill)] border border-[var(--border)] bg-[var(--bg-elevated)] px-6 text-sm font-medium text-[var(--text-primary)] no-underline transition-colors hover:bg-[var(--border-soft)]">
            {t("hero.cta2")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <TotpGenerator lang={currentLang} t={t} />
  <Vault lang={currentLang} t={t} />
  <SEOContent t={t} />
  <FAQ lang={currentLang} t={t} />
  <Footer lang={currentLang} t={t} />
</Layout>
