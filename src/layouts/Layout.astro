---
import '../styles/global.css';
import { languages, defaultLang } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  canonical?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; item: string }>;
  isWebApplication?: boolean;
  faqList?: Array<{ q: string; a: string }>;
}

const {
  title = 'Online TOTP Generator — Free Two-Factor Auth Codes (RFC 6238)',
  description = 'Free online TOTP generator for two-factor authentication. Generate RFC 6238 compliant codes, scan QR codes, save secrets to your vault, and auto-copy. 100% client-side — your secrets never leave your browser.',
  lang = defaultLang,
  canonical,
  noindex = false,
  breadcrumbs,
  isWebApplication = true,
  faqList,
} = Astro.props;

const siteName = 'TOTP Generator';
const ogImage = 'https://realtotpgenerator.com/og-image.png';
const baseUrl = 'https://realtotpgenerator.com';

const rawSubpath = Astro.url.pathname.replace(new RegExp(`^\\/${lang}(\\/|$)`), "/");
const subpath = rawSubpath.startsWith("/") ? rawSubpath : `/${rawSubpath}`;
const targetPath = subpath === "/" ? "/" : subpath;
const pageUrl = canonical || `${baseUrl}/${lang}${targetPath}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0K52MF85PN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0K52MF85PN');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="TOTP Generator" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <link rel="canonical" href={pageUrl} />

    <!-- Hreflang for all languages (only for indexable pages) -->
    {!noindex && Object.keys(languages).map((l) => (
      <link rel="alternate" hreflang={l} href={`${baseUrl}/${l}${targetPath}`} />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={`${baseUrl}/en${targetPath}`} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TOTP Generator - Free Online Two-Factor Authentication Code Generator" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : lang.replace('-', '_')} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="TOTP Generator - Free Online Two-Factor Authentication Code Generator" />

    <!-- Additional SEO & PWA -->
    <meta name="theme-color" content="#171717" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="RealTOTPGenerator" />

    <!-- JSON-LD: WebApplication -->
    {isWebApplication && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "TOTP Generator",
        "url": pageUrl,
        "description": description,
        "applicationCategory": "SecurityApplication",
        "operatingSystem": "Any (Web Browser)",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "featureList": [
          "RFC 6238 compliant TOTP generation",
          "QR code scanning from camera",
          "QR code image upload",
          "Secure vault with localStorage",
          "Auto-copy to clipboard",
          "Dark mode support",
          "SHA-1, SHA-256, SHA-512 algorithms",
          "6 and 8 digit codes",
          "Clock drift detection",
          "100% client-side processing"
        ],
        "browserRequirements": "Requires a modern web browser with Web Crypto API support",
        "softwareVersion": "1.0",
        "author": { "@type": "Organization", "name": "TOTP Generator", "url": baseUrl }
      })} />
    )}

    <!-- JSON-LD: FAQPage (Rendered only when FAQs are present on page) -->
    {faqList && faqList.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqList.map((item) => ({
          "@type": "Question",
          "name": item.q,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.a
          }
        }))
      })} />
    )}

    <!-- JSON-LD: BreadcrumbList -->
    {breadcrumbs && breadcrumbs.length > 0 ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbs.map((b, idx) => ({
          "@type": "ListItem",
          "position": idx + 1,
          "name": b.name,
          "item": b.item
        }))
      })} />
    ) : targetPath === '/' ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": `${baseUrl}/${lang}/` }]
      })} />
    ) : null}

    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-[var(--bg)] text-[var(--text-primary)] transition-colors duration-200">
    <slot />
    <script is:inline src="/animations.js"></script>
  </body>
</html>
