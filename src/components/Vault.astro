---
interface Props {
  lang?: string;
  t?: (key: string) => string;
}
const { lang = "en", t = (k: string) => k } = Astro.props;
---

<section id="vault" class="border-t border-[var(--border)] py-16">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="mx-auto max-w-[640px]" data-animate="fade-up">
      <p class="mb-2 font-[var(--font-mono)] text-xs font-medium uppercase tracking-widest text-[var(--text-muted)]">
        Vault
      </p>
      <h2 class="font-heading mb-3 text-2xl tracking-tight text-[var(--text-primary)]">
        {t("vault.title")}
      </h2>
      <p class="mb-8 text-sm text-[var(--text-secondary)]">
        {t("vault.desc")}
      </p>
      <div id="vault-entries" class="flex flex-col gap-2" data-t-load={t("vault.load")} data-t-empty={t("vault.empty")}>
        <p class="text-sm text-[var(--text-muted)]">{t("vault.empty")}</p>
      </div>
    </div>
  </div>
</section>
