---
import LanguagePicker from "./LanguagePicker.astro";

interface Props {
  lang?: string;
  t?: (key: string) => string;
}

const { lang = "en", t = (k: string) => k } = Astro.props;
---

<nav class="fixed top-0 left-0 right-0 z-50 border-b border-[var(--border)] bg-[var(--bg-elevated)]/80 backdrop-blur-xl">
  <div class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-3">
    <a href={`/${lang}/`} class="flex items-center gap-2 text-[var(--text-primary)] no-underline">
      <svg class="h-6 w-6" viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="600" height="600" rx="135" fill="var(--text-primary)"/>
        <g transform="translate(300,300) scale(12.5) translate(-12,-12)" stroke="var(--bg)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 5V4a2 2 0 0 1 2-2h8.5L20 7.5V20a2 2 0 0 1-2 2H4"/>
          <polyline points="14 2 14 8 20 8"/>
          <rect width="8" height="5" x="2" y="13" rx="1"/>
          <path d="M8 13v-2a2 2 0 1 0-4 0v2"/>
        </g>
      </svg>
      <span class="text-sm font-semibold tracking-tight">TOTP Generator</span>
    </a>
    <div class="flex items-center gap-2">
      <a href="#generator" class="hidden rounded-[var(--radius-sm)] px-3 py-1.5 text-sm text-[var(--text-secondary)] no-underline transition-colors hover:text-[var(--text-primary)] sm:inline-block">
        {t("nav.generator")}
      </a>
      <a href="#vault" class="hidden rounded-[var(--radius-sm)] px-3 py-1.5 text-sm text-[var(--text-secondary)] no-underline transition-colors hover:text-[var(--text-primary)] sm:inline-block">
        {t("nav.vault")}
      </a>
      <a href="#faq" class="hidden rounded-[var(--radius-sm)] px-3 py-1.5 text-sm text-[var(--text-secondary)] no-underline transition-colors hover:text-[var(--text-primary)] sm:inline-block">
        {t("nav.faq")}
      </a>
      <LanguagePicker />
      <button id="theme-toggle" class="flex h-8 w-8 items-center justify-center rounded-[var(--radius-full)] border border-[var(--border)] bg-[var(--bg-elevated)] text-[var(--text-primary)] transition-colors hover:bg-[var(--border-soft)]" aria-label="Toggle theme">
        <svg class="h-4 w-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="hidden h-4 w-4 dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const isDark = html.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
