---
import { languages } from "../i18n/ui";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const currentFlag = languages[lang]?.countryCode || "un";
---

<div class="relative" id="lang-picker-wrapper">
  <button
    id="lang-picker-toggle"
    class="flex h-8 items-center gap-1.5 rounded-[var(--radius-full)] border border-[var(--border)] bg-[var(--bg-elevated)] px-2.5 text-xs font-medium text-[var(--text-primary)] transition-colors hover:bg-[var(--border-soft)]"
    aria-label="Select language"
    aria-expanded="false"
  >
    <img
      src={`https://flagcdn.com/24x18/${currentFlag}.png`}
      srcset={`https://flagcdn.com/24x18/${currentFlag}.png 1x, https://flagcdn.com/48x36/${currentFlag}.png 2x`}
      alt=""
      class="h-3 w-[18px] rounded-sm object-cover"
      width="18"
      height="13"
      loading="eager"
    />
    <svg class="h-3 w-3 text-[var(--text-muted)] transition-transform" id="lang-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>
  <div
    id="lang-picker-dropdown"
    class="absolute right-0 top-full z-50 mt-2 hidden max-h-[400px] w-[220px] overflow-y-auto rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-elevated)] py-1 shadow-[var(--shadow-card-hover)]"
  >
    {Object.entries(languages).map(([code, { name, countryCode }]) => (
      <a
        href={`/${code}/`}
        class={`flex items-center gap-2.5 px-3 py-2 text-xs no-underline transition-colors hover:bg-[var(--border-soft)] ${code === lang ? 'bg-[var(--border-soft)] font-medium text-[var(--text-primary)]' : 'text-[var(--text-secondary)]'}`}
        lang={code}
      >
        <img
          src={`https://flagcdn.com/24x18/${countryCode}.png`}
          srcset={`https://flagcdn.com/24x18/${countryCode}.png 1x, https://flagcdn.com/48x36/${countryCode}.png 2x`}
          alt=""
          class="h-3 w-[18px] rounded-sm object-cover"
          width="18"
          height="13"
          loading="lazy"
        />
        <span>{name}</span>
        {code === lang && (
          <svg class="ml-auto h-3 w-3 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
        )}
      </a>
    ))}
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var toggle = document.getElementById('lang-picker-toggle');
    var dropdown = document.getElementById('lang-picker-dropdown');
    var chevron = document.getElementById('lang-chevron');
    if (!toggle || !dropdown) return;

    toggle.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = !dropdown.classList.contains('hidden');
      if (isOpen) {
        dropdown.classList.add('hidden');
        chevron && chevron.classList.remove('rotate-180');
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        dropdown.classList.remove('hidden');
        chevron && chevron.classList.add('rotate-180');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });

    document.addEventListener('click', function(e) {
      if (!dropdown.contains(e.target) && e.target !== toggle) {
        dropdown.classList.add('hidden');
        chevron && chevron.classList.remove('rotate-180');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
